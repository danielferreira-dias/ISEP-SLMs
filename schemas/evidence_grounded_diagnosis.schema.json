{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_grounded_diagnosis.schema.json",
  "title": "Evidence-Grounded Dermatology Diagnosis",
  "description": "Structured morphology findings, an observation-only clinical description, six ranked diseases, evidence links, confidence, and an audit-only clinical review recommendation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "clinical_description",
    "differential",
    "case_confidence",
    "needs_in_person_review"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Visible morphology concepts selected from the SKINCON vocabulary.",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "concept_id",
          "confidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$",
            "description": "Response-local finding identifier. Semantic validation requires consecutive IDs beginning with F1."
          },
          "concept_id": {
            "type": "string",
            "description": "Controlled morphology concept identifier.",
            "enum": [
              "vesicle",
              "papule",
              "macule",
              "plaque",
              "abscess",
              "pustule",
              "bulla",
              "patch",
              "nodule",
              "ulcer",
              "crust",
              "erosion",
              "excoriation",
              "atrophy",
              "exudate",
              "purpura_petechiae",
              "fissure",
              "induration",
              "xerosis",
              "telangiectasia",
              "scale",
              "scar",
              "friable",
              "sclerosis",
              "pedunculated",
              "exophytic_fungating",
              "warty_papillomatous",
              "dome_shaped",
              "flat_topped",
              "brown_hyperpigmentation",
              "translucent",
              "white_hypopigmentation",
              "purple",
              "yellow",
              "black",
              "erythema",
              "comedo",
              "lichenification",
              "blue",
              "umbilicated",
              "poikiloderma",
              "salmon",
              "wheal",
              "acuminate",
              "burrow",
              "gray",
              "pigmented",
              "cyst"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Model-reported confidence that the morphology concept is visible."
          }
        }
      }
    },
    "clinical_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Concise observation-only description of visible image findings. Semantic validation forbids diagnoses, tests, treatment, and management recommendations."
    },
    "differential": {
      "type": "array",
      "description": "Exactly six unique diseases ordered from most to least plausible.",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "disease_id",
          "confidence",
          "supporting_finding_ids"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "disease_id": {
            "type": "string",
            "description": "Disease identifier from the active benchmark taxonomy.",
            "enum": [
              "D001",
              "D002",
              "D003",
              "D004",
              "D005",
              "D006",
              "D007",
              "D009",
              "D011",
              "D012",
              "D013",
              "D014",
              "D015",
              "D016",
              "D017",
              "D018",
              "D019",
              "D022",
              "D023",
              "D024",
              "D025"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Model-reported confidence for this disease."
          },
          "supporting_finding_ids": {
            "type": "array",
            "description": "Finding IDs declared in this response and cited as evidence for the disease.",
            "minItems": 1,
            "maxItems": 48,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^F[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "case_confidence": {
      "type": "string",
      "description": "Confidence band derived from the top-ranked disease confidence.",
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "needs_in_person_review": {
      "type": "boolean",
      "description": "Audit-only recommendation; no referral ground truth is available in benchmark v1."
    }
  }
}
