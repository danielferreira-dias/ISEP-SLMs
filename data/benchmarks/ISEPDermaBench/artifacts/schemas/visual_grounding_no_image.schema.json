{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_grounding_no_image.schema.json",
  "title": "No-image visual-grounding assessment",
  "description": "Structured output for the uniform-gray dermatology grounding control.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image_status",
    "visual_findings",
    "predictions",
    "confidence"
  ],
  "properties": {
    "image_status": {
      "type": "string",
      "enum": ["not_evaluable", "evaluable"]
    },
    "visual_findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predictions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "disease_id"],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "disease_id": {
            "type": "string",
            "enum": [
              "D001", "D002", "D003", "D004", "D005", "D006", "D007",
              "D009", "D011", "D012", "D013", "D014", "D015", "D016",
              "D017", "D018", "D019", "D022", "D023", "D024", "D025"
            ]
          }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "moderate", "high"]
    }
  }
}
