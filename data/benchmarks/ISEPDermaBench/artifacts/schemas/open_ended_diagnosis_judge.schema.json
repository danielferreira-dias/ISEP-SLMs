{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-ended dermatology diagnosis judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reference_diagnosis_rank",
    "diagnosis_correctness",
    "visual_findings_correctness",
    "evidence_grounding",
    "clinical_rationale_quality",
    "differential_quality",
    "unsupported_claim_count",
    "unsupported_claim_examples",
    "overall_verdict",
    "judge_summary"
  ],
  "properties": {
    "reference_diagnosis_rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "1-3 when the reference is explicitly ranked there; 0 when absent or unranked."
    },
    "diagnosis_correctness": {"type": "integer", "minimum": 0, "maximum": 4},
    "visual_findings_correctness": {"type": "integer", "minimum": 0, "maximum": 4},
    "evidence_grounding": {"type": "integer", "minimum": 0, "maximum": 4},
    "clinical_rationale_quality": {"type": "integer", "minimum": 0, "maximum": 4},
    "differential_quality": {"type": "integer", "minimum": 0, "maximum": 4},
    "unsupported_claim_count": {"type": "integer", "minimum": 0},
    "unsupported_claim_examples": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 10
    },
    "overall_verdict": {
      "type": "string",
      "enum": ["correct", "mostly_correct", "partially_correct", "incorrect"]
    },
    "judge_summary": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
